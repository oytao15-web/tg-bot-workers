{
  "name": "tg-bot-workers",
  "version": "1.0.0",
  "description": "Telegram Group Management Bot on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tg-bot-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute tg-bot-db --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240614.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.60.0"
  },
  "dependencies": {
    "grammy": "^1.27.0"
  }
}
